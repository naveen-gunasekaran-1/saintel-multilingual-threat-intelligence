# Docker does NOT honour .gitignore. Without this file, `COPY src/ ./src/`
# bakes src/layer1_ingestion/*.session -- a live Telegram auth_key -- into
# every image pushed to a registry.

# ---- Secrets ----
.env
.env.*
*.session
*.session-journal

# ---- VCS / envs ----
.git/
.gitignore
venv/
.venv/

# ---- Caches ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Large regenerable artifacts ----
data/models/
*.bin

# ---- Not needed at runtime ----
docs/
k8s/
tests/
results/
requirements.lock.txt
docker-compose.yml
.DS_Store
