# SAINTEL environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and MUST NEVER be committed.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ---- Kafka ----
# NOTE: src/layer0_scrapers/*.py currently hardcode "raw_threat_stream" and
# ignore these vars. Reconciled in Phase 4.
KAFKA_BROKER_URL=localhost:9092
KAFKA_RAW_TOPIC=raw_threat_stream
KAFKA_SIGNAL_TOPIC=high_intent_signals
KAFKA_ENTITY_TOPIC=layer3_entities

# ---- Neo4j (required: config.py raises RuntimeError if NEO4J_PASSWORD is unset) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=replace_with_neo4j_user
NEO4J_PASSWORD=replace_with_strong_neo4j_password
# NEO4J_DATABASE is read by neither config.py nor neo4j_connector.py
# (Neo4jSessionManager defaults to database="neo4j"). Kept for Aura reference only.
NEO4J_DATABASE=neo4j

# ---- Aura console metadata (not read by any code; identifies the instance) ----
# AURA_INSTANCEID=
# AURA_INSTANCENAME=

# ---- PostgreSQL (required: config.py raises RuntimeError if POSTGRES_DSN is unset) ----
# Currently only used for a `SELECT 1` health check in the dashboard.
POSTGRES_USER=replace_with_postgres_user
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=saintel_db
POSTGRES_DSN=postgresql://replace_with_postgres_user:replace_with_strong_postgres_password@localhost:5432/saintel_db

# ---- Models ----
MODEL_PATH=./data/models/edge_triage_model.bin
NLP_MODEL_NAME=xlm-roberta-base
ZERO_SHOT_MODEL_NAME=facebook/bart-large-mnli
# Read at import time by src/layer3_native_nlp/entity_extractor.py
HF_TOKEN=replace_with_huggingface_token

# ---- Telegram (read by src/layer1_ingestion/telegram_scraper.py) ----
# Obtain API_ID / API_HASH from https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=replace_with_telegram_api_hash
TELEGRAM_SESSION_NAME=saintel_scraper

# ---- Optional LLM providers ----
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
